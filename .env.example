# Okta service app havlund-hr-sync (signs in with a private key, not a password)
OKTA_ORG_URL=https://your-org.okta.com
OKTA_CLIENT_ID=your-service-app-client-id
OKTA_PRIVATE_KEY_PATH=path\to\your-private-key.pem

# Entra app havlund-drift-check (read only, signs in with a certificate)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-app-client-id
ENTRA_CERT_THUMBPRINT=your-cert-thumbprint
ENTRA_PRIVATE_KEY_PATH=path\to\your-private-key.pem

# Keep private keys outside the repo
